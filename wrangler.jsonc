{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static Astro build (landing at "/", billing app at "/app/") served by Workers Static Assets.
  "name": "payzenmax",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
