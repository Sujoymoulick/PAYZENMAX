---
// The PayzenMax billing app. Mounts the existing React MVP (src/App.tsx) unchanged
// as a client-only island, since it relies on browser storage.
import { App } from '../App';
import '../index.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>PayzenMax.com — Offline-Ready GST Billing &amp; Business Platform</title>
    <!-- Google Fonts: IBM Plex Sans & IBM Plex Mono from design reference -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F6F6F3] text-[#17181A] antialiased selection:bg-[#1B5E3B] selection:text-white">
    <div id="root">
      <App client:only="react" />
    </div>
  </body>
</html>
